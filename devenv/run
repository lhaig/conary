#!/bin/bash
# Run a command in the Conary Fedora dev container with the repo at /src.
# Usage: devenv/run <command> [args...]   (no args: interactive bash)
#   DEVENV_PLATFORM=linux/amd64  run the x86_64 image (emulated on arm64 hosts)
#   DEVENV_ROOT=1                run as root instead of the invoking user
#   CONARY_POLICY_SRC=<dir>      conary-policy checkout to mount at /policy (default ../conary-policy)
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
HASH=$(shasum -a 256 "$ROOT/devenv/Dockerfile" | cut -c1-12)
PLATFORM=${DEVENV_PLATFORM:-}
TAG="conary-devenv:$HASH"
platform_args=()
if [ -n "$PLATFORM" ]; then
    # One tag per platform so native and emulated images never collide.
    TAG="$TAG-${PLATFORM##*/}"
    platform_args=(--platform "$PLATFORM")
fi

if ! docker image inspect "$TAG" >/dev/null 2>&1; then
    echo "devenv: building $TAG" >&2
    docker build ${platform_args[@]+"${platform_args[@]}"} -t "$TAG" "$ROOT/devenv" >&2
fi

[ $# -gt 0 ] || set -- bash

# conary-policy checkout (read-only at /policy, CONARY_POLICY_PATH set); see policy_src.sh.
. "$ROOT/devenv/policy_src.sh"

args=(--rm -i -v "$ROOT":/src -w /src)
[ -t 0 ] && args+=(-t)
args+=(${platform_args[@]+"${platform_args[@]}"})
args+=(${policy_args[@]+"${policy_args[@]}"})
# Run as the invoking user so files written to the bind mount are not root-owned
# (and permission tests do not silently skip as root).
if [ "${DEVENV_ROOT:-}" != 1 ]; then
    args+=(--user "$(id -u):$(id -g)" -e HOME=/tmp)
fi

exec docker run "${args[@]}" "$TAG" "$@"
